            "textPadding": 5.0,
            "slider": null
        },
        {
            "type": "Button",
            "id": "submit_score_button",
            "element": {
                "bounds": { "x": 320, "y": 335, "w": 160, "h": 40 },
                "backgroundColor": { "r": 0, "g": 0, "b": 0, "a": 0 },
                "borderColor": { "r": 0, "g": 0, "b": 0, "a": 0 }
