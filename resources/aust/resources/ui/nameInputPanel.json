                "fontColor": { "r": 255, "g": 255, "b": 255, "a": 255 },
                "textAlignment": { "horizontal": "center", "vertical": "middle" }
            }
        },
        {
            "type": "TextField",
            "id": "input_field",
            "element": {
                "bounds": { "x": 240, "y": 275, "w": 320, "h": 40 },
                "backgroundColor": { "r": 30, "g": 30, "b": 30, "a": 255 },
                "borderColor": { "r": 255, "g": 255, "b": 255, "a": 255 }
            },
            "textElement": null,
            "textStyle": {
                "fontFamily": "label",
                "fontSize": 20.0,
                "fontColor": { "r": 255, "g": 255, "b": 255, "a": 255 },
                "textAlignment": { "horizontal": "center", "vertical": "middle" }
            },
            "placeholderText": "(Leave blank to skip)",
            "maxLength": 32,
            "dataBindKey": "score_name",
            "numericOnly": false,
            "showSlider": false,
            "blinkTime": { "ms": 500.0 },
            "onTextInputStart": null,
            "onTextInputStop": null,
            "dataSource": null,
            "binding": null,
