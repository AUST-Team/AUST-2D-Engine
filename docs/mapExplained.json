{
  "name": "DebugMap", // Name of the map.
  "dimensions": [50, 50], // Dimensions [width, height].
  "music": "map1music", // Music to play, if any.

  "player": { // Player details.
    "playerStart": { "x": 0, "y": 1 }, // Start tile.
    "playerFacing": "right" // Facing direction.
  },

  "baseTile": "Grass", // Base tile.

  "defaultDialogue": "playerCaughtNode", // Default dialogue for guards.

  "tiles": [
    {
      "name": "Mountain", // Name of the tile (from tiles.json).
      "placement": "Default", // Type of placement; can be overriden, but if used with 'default' or 'null' it will use the one defined in the tiles JSON.
      "positions": [
        { "x": 11, "y": 11 }, // Now here is an interesting one. To facilitate easier placement, you can place multiple tiles in a single declaration. This here is a single tile.
        { "x": { "range": [15, 20] }, "y": 16 }, // This is a horizontal line of tiles.
        { "x": { "range": [5, 10] }, "y": 7 } // Also a horizontal line of tiles. These are detailed in the misc section in the PDF file.
      ]
    },
    {
      "name": "EvilTile",
      "placement": "Default",
      "positions": [
        { "x": {"range": [5, 6]}, "y": {"range": [5, 6]} } // A square of tiles!
      ]
    },
    {
      "name": "Rock",
      "placement": "Replace", // Here we see an override. This will take precedence over the one in tiles.json!
      "positions": [
        { "x": 10, "y": 2 }
      ]
    }
  ],

  "presets": [
    {
      "name": "Lake", // Name of the preset. Case-insensitive. Preset must be in aust/resources/presets/[name].json (for the base game).
      "placement": null, // Use tile's default!
      "position": { "x": 25, "y": 2 } // Upper left corner! The preset expands down and to the right.
    }
  ],

  "guards": [
    {
      "id": 0, // ID of the guard. Ideally these are in order until I get around to make a better system.
      "type": "idle", // Type of guard.
      "spawn": { "x": 5, "y": 5 }, // Spawn.
      "dialogueOverride": null, // Dialogue override. When catching the player, it will use this if any.
      "facing": "Down" // Starting facing position.
    },
    {
      "id": 1,
      "type": "patrol", // This one patrols!
      "spawn": { "x": 1, "y": 1 },
      "path": [
        { "x": 1, "y": 1 }, // Goes from each point to the next, in this order. Spawn not included. If the guard is spawned anywhere else, it will path to the first point then start the patrol.
        { "x": 8, "y": 8 },
        { "x": 3, "y": 3 },
        { "x": 1, "y": 3 }
      ],
      "dialogueOverride": null,
      "facing": "Left"
    }
  ],

  // Triggers had 5 refactors! They replaced the interactables.
  "triggers": [
    {
      "name": "trigger_1",
      "position": { "x": 11, "y": 11 },
      
      "flags": { // Trigger flags!
        "repeatable": true, // Can this trigger be repeatable?
        "autoDelete": false, // Does this trigger autodelete once triggered? If both this and 'repeatable' are set, it will still autodelete
        "triggered": true / false // Flag if the trigger should spawn pre-triggered. Default false.
      },

      // Oh yeah baby, a classic example of composite design pattern that isn't dumb and stupid!
      // See conditionsExample.json for the full list.
      "conditions": { 
        "or": [
          {"type": "interact"},
          {"type": "steppedOn"},
          {"and": [
            {"type": "proximity", "range": 4},
            {"type": "facing", "facing": "away"}
          ]} 
        ]
      },

      // See eventsExample.json, but yes, you can chain events!
      "events": [
        {
          "game:startDialogue": {
            "type": "narration",
            "lines": [
              "Hiiiiii",
              "I am interactable",
              "A really long line to test out if wrapping works and also skipping because I am working sharklessly at these systems. Did you know that in Java, scrolling was automatic, but you couldn't scroll back up, good luck if you skipped. But now in C++ you can scroll! Amazing, isn't it?"
            ],
            "onEnd": [
              {
                "game:startDialogue": {
                  "type": "narration",
                  "lines": ["Hello Hiiii, I am the next line", "Hello again!"],
                  "onEnd": [
                    {
                      "game:startDialogue": {
                        "type": "choice",
                        "question": "This is a question",
                        "randomizeAllChoices": false,
                        "choices": [
                          {
                            "text": "Set Tile",
                            "actions": {
                              "game:setTile": {
                                "positions": [ {"x": 10, "y": 10} ],
                                "name": "TownSoil",
                                "placement": "Replace"
                              }
                            }
                          },
                          {
                            "text": "Set Trigger",
                            "actions": {
                              "game:setTrigger": {
                                "name": "trigger_2",
                                "position": {"x": 10, "y": 10},
                                
                                "flags": {
                                  "repeatable": true,
                                  "autoDelete": false
                                },

                                "conditions": {
                                  "type": "interact"
                                },

                                "events": {
                                  "game:startDialogue": {
                                    "type": "narration",
                                    "lines": "I am a brand new trigger",
                                    "onEnd": null
                                  }
                                }
                              }
                            }
                          },
                          {
                            "text": "Set Preset",
                            "actions": {
                              "game:setPreset": {
                                "position": {"x": 15, "y": 15},
                                "name": "lake",
                                "placement": null
                              }
                            }
                          },
                          {
                            "text":"4",
                            "actions": null
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  ]
}